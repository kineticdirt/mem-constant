# Copy to linuxbox: ~/.cloudflare/access-setup.env (chmod 600)
# DO NOT commit a filled-in copy — this .example is safe (no secrets).

CLOUDFLARE_API_TOKEN=REPLACE_WITH_YOUR_TOKEN
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_YOUR_ACCOUNT_ID
CLOUDFLARE_ZONE_NAME=abhinavall.net
ALLOWED_EMAIL=REPLACE_WITH_YOUR_EMAIL

# Edge SSO toggle for /Linuxbox/ (see scripts/linuxbox/cloudflare-access-toggle.sh)
# on  = Google/OTP required at Cloudflare Access (default)
# off = bypass Access; HTTP Basic still applies unless DASHBOARD_OPEN=read|all
CLOUDFLARE_ACCESS_SSO_ENABLED=on
