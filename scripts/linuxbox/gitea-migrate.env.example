# Copy to potato (NOT into git):
#   cp scripts/linuxbox/gitea-migrate.env.example ~/.gitea-migrate.env
#   chmod 600 ~/.gitea-migrate.env
#   # edit: set GITEA_ADMIN_PASSWORD to the admin password from the install wizard
#   # then:
#   set -a; . ~/.gitea-migrate.env; set +a
#   bash ~/agent-dump/scripts/linuxbox/gitea-migrate-rp-from-bare.sh --owner username --user username
#
# Never commit ~/.gitea-migrate.env. Never put the password in AI_GROUPCHAT.md or docs.

GITEA_USER=username
GITEA_ADMIN_PASSWORD=
