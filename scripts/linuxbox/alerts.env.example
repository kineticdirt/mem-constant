# Copy to ~/.linuxbox-dashboard/alerts.env (chmod 600). Never commit.

# Email via Resend (https://resend.com) — optional
# RESEND_API_KEY=re_...
# ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_FROM=linuxbox@abhinavall.net

# Push via ntfy.sh — optional (create a private topic name)
# ALERT_NTFY_URL=https://ntfy.sh/your-secret-topic

# Dashboard loopback auth (for /api/systems snapshot); defaults match ~/.linuxbox-dashboard/.env
# DASHBOARD_TOKEN=...
# DASHBOARD_ADMIN_USER=admin
