[Unit]
Description=Cloudflare tunnel — abhinavall.net backend (site + /Linuxbox + /Intel)
Documentation=file:///home/abhinav/agent-dump/docs/cloudflare-tunnels-linuxbox.md
After=network-online.target abhinavall-origin-8780.service
Wants=network-online.target abhinavall-origin-8780.service

[Service]
Type=notify
TimeoutStartSec=30
EnvironmentFile=/home/abhinav/.cloudflare/abhinavall-tunnel.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token ${TUNNEL_TOKEN}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
