# linuxbox dashboard credentials — copy to ~/.linuxbox-dashboard/.env (chmod 600)
# Never commit real values. Live passwords live only on the box — see potato ~/.linuxbox-dashboard/.env

# Admin (full control: Hub, Inbox, Chat, Tasks, Meta, campaigns)
DASHBOARD_TOKEN=generate-a-long-random-string
DASHBOARD_ADMIN_USER=admin

# Viewer (read-only: News, stocks/intel, public docs — no agent control)
DASHBOARD_VIEWER_TOKEN=generate-another-long-random-string
DASHBOARD_VIEWER_USER=viewer

# Extra named accounts (JSON array). role = admin | viewer
# Example: HeadUser (admin-equivalent), guest (viewer-equivalent)
# DASHBOARD_EXTRA_ACCOUNTS=[{"user":"HeadUser","role":"admin","pass":"..."},{"user":"guest","role":"viewer","pass":"..."}]

# Public access toggle (default off). Use only behind Cloudflare Access.
# DASHBOARD_OPEN=off

# Bitwarden entries (after Cloudflare Access Google login):
#   URL: https://abhinavall.net/Linuxbox/
#   One entry per username; passwords from box .env only (never paste into git/docs).
