# Private keys — never commit
id_rsa_potato
*.pem

# Local linuxbox secrets (Discord etc.) — edit on PC, sync via scripts/pc/sync-linuxbox-secrets.sh
secrets/linuxbox.env
**/.env
!**/.env.example

# Machine-specific remote streaming config (Tailscale IPs, MACs)
scripts/remote-stream-companion/config.psd1

# USB kit local secrets (Apollo password etc.) - copied to E: only, never commit
scripts/laptop-usb-kit/secrets-local/

# Hermes external continuity checkpoint (local machine state)
hermes/state.json

# Node
node_modules/

# Python packaging / test
*.egg-info/
dist/
build/
.pytest_cache/
__pycache__/
*.pyc

# Runtime truth — potato-owned, mutated by live services/agents; never carried
# by git so deploy resets cannot revert it (docs/runtime-state-protection.md).
campaigns/*/characters-registry.json
# regions-ui.json is intentionally TRACKED: HEAD carries last-known-good GM
# borders (v19, 2026-08-04) so git stubs can never win — REGIONS-UI-LOCK.md.
# skip-worktree on potato/PC keeps live GM saves local until committed on purpose.
agents/user-tasks.json
agents/archive-meta.json
agents/swarm-queue.json
agents/dashboard-lane-state.json
agents/state/*
!agents/state/.gitkeep
!agents/state/multitask-locks/
agents/state/multitask-locks/*
!agents/state/multitask-locks/.gitkeep
campaigns/*/characters/portraits/**
!campaigns/*/characters/portraits/README.md
backups/state/
# Isla Primavera sim runtime (isla-sim.js) — code is tracked, world state is not
# (on potato prefer ISLA_SIM_STATE under agents/state/ per runtime-state-protection).
scripts/linuxbox/tableslop-static/sim/sim-state.json
scripts/linuxbox/tableslop-static/sim/sim-static.json
scripts/linuxbox/tableslop-static/sim/sim-broadcast.json
scripts/linuxbox/tableslop-static/sim/sim-gm-overrides.json
# mem-constant session carryover (may contain chat excerpts)
.mem-constant/last-session.md
.mem-constant/.hook-buffer.jsonl
