# Copy to secrets/linuxbox.env (gitignored) — single paste point on your PC.
# Sync to linuxbox: bash scripts/pc/sync-linuxbox-secrets.sh

# Discord (Developer Portal → Bot → Token)
DISCORD_BOT_TOKEN=
DISCORD_TOKEN=
DISCORD_GUILD_ID=1012888284222988409
DISCORD_CATEGORY_ID=1137592539076120666
DISCORD_ALLOWED_USERS=

# tableslop map OAuth (same Discord app → OAuth2 → Client ID + Secret)
# Redirect URI in portal: https://map.tableslop.org/auth/discord/callback
# Docs: docs/tableslop-discord-auth.md — public view, login+role required to edit.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://map.tableslop.org/auth/discord/callback
TABLESLOP_REQUIRE_DISCORD_AUTH=1
# openssl rand -hex 32 — signs session cookies; rotating logs everyone out
TABLESLOP_SESSION_SECRET=
# Your Discord user id (Discord → Settings → Advanced → Developer Mode → right-click self → Copy User ID)
TABLESLOP_OWNER_DISCORD_ID=

# Optional — OpenRouter split (linuxbox Hermes)
# OPENROUTER_API_KEY_RP=
# OPENROUTER_API_KEY_OPS=

# Optional — ZenMux (second OpenAI-compatible provider alongside OpenRouter; linuxbox Hermes/Pixi).
# Enables `hermes --provider zenmux -m <slug>` and the `zenmux:<slug>` dashboard prefix.
# Leave unset to keep OpenRouter-only behaviour. Base URL: https://zenmux.ai/api/v1
# ZENMUX_API_KEY=
