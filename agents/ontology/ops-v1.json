{
  "_doc": "Ops ontology v1 — potato-sized stand-in for OWL (Coyle). Enforced by scripts/linuxbox/ontology-ledger-check.py. Not a full reasoner.",
  "id": "ops-v1",
  "classes": {
    "UserTask": {
      "properties": {
        "id": { "type": "string", "required": true },
        "status": { "type": "enum", "oneOf": ["open", "in_progress", "done", "blocked"] },
        "title": { "type": "string" }
      }
    },
    "LaneAssignment": {
      "properties": {
        "assigned_lane": {
          "type": "enum",
          "oneOf": ["hermes", "cursor", "archived"]
        }
      }
    },
    "MapRole": {
      "properties": {
        "role": { "type": "enum", "oneOf": ["owner", "admin", "user"] }
      },
      "disjoint": true,
      "note": "owl:disjointWith stand-in — one role per Discord user"
    }
  },
  "functional": [
    "UserTask.id",
    "UserTask.context.assigned_lane"
  ],
  "transitions": {
    "UserTask.status": {
      "open": ["in_progress", "done", "blocked"],
      "in_progress": ["open", "done", "blocked"],
      "done": [],
      "blocked": ["open"]
    }
  },
  "rules": [
    {
      "id": "archived-implies-blocked",
      "when": { "assigned_lane": "archived" },
      "require": { "status": "blocked" }
    },
    {
      "id": "no-invented-status",
      "note": "owl:oneOf — reject status strings outside enum"
    }
  ],
  "door": {
    "_doc": "Pydantic-at-the-door (Coyle): validate tool-ish payloads BEFORE any disk write. Ledger (ontology-ledger-check) still owns transitions/semantics. Unknown payload fields are allowed (forward-compatible).",
    "user_task_status_patch": {
      "_doc": "Flipping a task's status (tick, dashboard API, failover).",
      "fields": {
        "id": { "type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "status": { "type": "enum", "required": true, "oneOf": ["open", "in_progress", "done", "blocked"] },
        "prior_status": { "type": "enum", "oneOf": ["open", "in_progress", "done", "blocked"] },
        "agent_note": { "type": "string", "max_len": 2000 }
      }
    },
    "lane_failover_record": {
      "_doc": "CLI args to lane-failover.py record / after-run.",
      "fields": {
        "task_id": { "type": "string", "required": true },
        "lane": { "type": "enum", "required": true, "oneOf": ["think", "hermes", "cursor"] },
        "n": { "type": "int", "min": 1, "max": 10 },
        "exit_code": { "type": "int", "min": 0, "max": 255 }
      }
    },
    "inbox_seed_append": {
      "_doc": "One item for human-inbox open[] or inbox-seeds.json items[] — enforces rich CONTEXT rule.",
      "fields": {
        "id": { "type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "type": { "type": "enum", "required": true, "oneOf": ["text", "choice", "multi"] },
        "question": { "type": "string", "required": true, "min_len": 8 },
        "context": { "type": "string", "required": true, "min_len": 40 },
        "campaign": { "type": "string" },
        "from": { "type": "string" },
        "options": {
          "type": "list",
          "item": "string",
          "required_if": { "field": "type", "oneOf": ["choice", "multi"] }
        },
        "option_help": { "type": "list", "item": "string" },
        "allow_other": { "type": "bool" }
      }
    }
  }
}
